letter_count = []

for char in phrase:
    if char.isalpha():
        char = char.lower() 
        counter = counter + 1
        
        if char in letter_in_phrase:
            
            position = letter_in_phrase.index(char)
            letter_count[position] = letter_count[position] + 1
        
        else:
            letter_in_phrase.append(char)
            letter_count.append(1)
            
            
