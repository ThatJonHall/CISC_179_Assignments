def convert_kpl_to_mpg(kpl):
    return kpl * 2.352145

def convert_mpg_to_kpl(mpg):
    return mpg * 0.425144

while True:
    start = input("Press '1' to convert KPL to MPG or '2' for MPG to KPL: ")

    if start == "1":
        kpl_input = int(input("How many kilometers per liter? "))
        result = convert_kpl_to_mpg(kpl_input)
        print(result)
        break
    elif start == "2":
        mpg_input = int(input("How many kilometers per liter? "))
        result = convert_mpg_to_kpl(mpg_input)
        print(result)
        break
    else:
        print ("it's 1 or 2, not that hard")

